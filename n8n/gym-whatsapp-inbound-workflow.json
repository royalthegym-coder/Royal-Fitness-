      },
      "id": "a1c6d2f0-1e11-4e70-9a01-000000000001",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "gym-whatsapp-inbound"
    },
    {
      "parameters": {
        "jsCode": "// Normalize Meta WhatsApp Cloud webhook payload.\nconst root = $json.body ?? $json;\nconst entry = root.entry?.[0];\nconst change = entry?.changes?.[0];\nconst value = change?.value ?? root.value ?? root;\nconst messages = value.messages ?? [];\nconst contacts = value.contacts ?? [];\n\nreturn messages.map((message) => {\n  const contact = contacts.find((c) => c.wa_id === message.from) ?? contacts[0];\n  const type = message.type ?? 'unknown';\n\n  let text = '';\n  if (type === 'text') text = message.text?.body ?? '';\n  else if (type === 'button') text = message.button?.text ?? '';\n  else if (type === 'interactive') {\n    text = message.interactive?.button_reply?.title\n      ?? message.interactive?.list_reply?.title\n      ?? '';\n  }\n\n  return {\n    json: {\n      provider: 'whatsapp_cloud',\n      message_id: message.id ?? null,\n      from: message.from ?? null,\n      customer_name: contact?.profile?.name ?? 'Customer',\n      message_type: type,\n      text,\n      timestamp: message.timestamp ?? null,\n      phone_number_id: value.metadata?.phone_number_id ?? null,\n      waba_id: entry?.id ?? null,\n      raw_message: message\n    }\n  };\n}).filter(item => item.json.message_id && item.json.from);"
      },
      "id": "a1c6d2f0-1e11-4e70-9a01-000000000002",
      "name": "Normalize Incoming Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ais-pre-hakfvy5pcvvusj25knx2eb-9972469637.asia-east1.run.app/api/v1/integrations/whatsapp/inbound",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.message_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
