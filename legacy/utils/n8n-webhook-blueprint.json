    {
      "parameters": {
        "jsCode": "const payload = $node[\"Webhook Trigger\"].json.body || $node[\"Webhook Trigger\"].json;\nconst member = $node[\"Query Supabase State\"].json;\n\n// Production Schema fields: full_name, phone_number, plan_tier, status, inactivity_days\nconst userName = member.full_name || payload.full_name || \"Champion\";\nconst eventName = payload.event || \"User absent for 4+ days (CHURN_RISK check)\";\nlet messageText = \"\";\nlet templateName = \"\";\n\nif (eventName.includes(\"Diet Page\") || eventName.includes(\"Diet\")) {\n  messageText = `Hey ${userName}! ⚡ We noticed you've been away from the gym, but your nutrition focus is active. Let's power up! Reply 'COACH' to adjust your workout intensity or ask for custom diet modifications!`;\n  templateName = \"retention_diet_engagement\";\n} else {\n  messageText = `Hey ${userName}! 🚀 It's been ${member.inactivity_days || 4} days since your last check-in. Your custom 'FutureOS' fitness tracker is waiting. Let's crush a workout today!`;\n  templateName = \"generic_absentee_10_days\";\n}\n\nreturn {\n  member_id: member.id || payload.member_id,\n  phone_number: (member.phone_number || payload.phone_number || payload.phone || '').replace(/^\\+?91/, ''),\n  full_name: userName,\n  plan_tier: member.plan_tier || payload.plan_tier || 'Standard',\n  status: member.status || 'ACTIVE',\n  messageText,\n  templateName\n};"
      },
      "id": "8c42b7d9-c0ae-4f04-9494-b77da1b8fa8a",
      "name": "Generate Highly Personalized Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        250
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"91{{ $json.phone_number }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"{{ $json.templateName }}\",\n    \"language\": {\n      \"code\": \"en_US\"\n    },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"{{ $json.full_name }}\"\n          },\n          {\n            \"type\": \"text\",\n            \"text\": \"4 days\"\n          }\n        ]\n      }\n    ]\n  }\n}",
        "options": {}
      },
