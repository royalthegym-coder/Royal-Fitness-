rules_version = '2';

// =============================================================================
// Fitness Future — Firestore Security Rules (Phase 2, Spark plan)
//
// Roles
//   super_admin : ONLY royalthegym@gmail.com, email_verified, signed in with TOTP 2FA.
//                 Derived from the ID token — no Firestore doc can grant it.
//   admin       : gym owner. Created only from a super_admin invite.
//   trainer     : created only from an admin invite, scoped to that admin's gymId.
//   member      : created from an admin invite, or self-signup (status "pending"
//                 until an admin approves).
//
// Tenant isolation: every per-gym document carries `gymId` and its document id
// starts with `${gymId}_`. Non-super-admins can only read/write their own gymId.
// Trainers only see members assigned to them; members only see their own records.
// Users can never change their own role, gymId, status or memberId.
// A gym with status "suspended" (set only by the super admin) locks out its admin,
// trainers and members until it is re-activated.
// Default: deny.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Set to false ONLY if TOTP cannot be enabled on the project (see DEPLOY.md).
    // Must match VITE_SUPER_ADMIN_REQUIRES_MFA in the web app.
    function superAdminRequiresMfa() { return true; }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'royalthegym@gmail.com'
        && request.auth.token.email_verified == true
        && (!superAdminRequiresMfa()
            || request.auth.token.firebase.sign_in_second_factor == 'totp');
    }

    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function hasProfile() { return signedIn() && exists(userPath(uid())); }
    function me() { return get(userPath(uid())).data; }
    function active() { return hasProfile() && me().status == 'active'; }
    function myGym() { return me().gymId; }
    function myRole() { return me().role; }

    // Gym not suspended by the super admin (missing status = active).
    function gymOpen(g) {
      return get(/databases/$(database)/documents/gyms/$(g)).data.get('status', 'active') != 'suspended';
    }
    function isAdminOf(g)   { return active() && myRole() == 'admin'   && myGym() == g && gymOpen(g); }
    function isTrainerOf(g) { return active() && myRole() == 'trainer' && myGym() == g && gymOpen(g); }
    function isMemberOf(g)  { return active() && myRole() == 'member'  && myGym() == g && gymOpen(g); }
    function isStaffOf(g)   { return active() && myRole() in ['admin', 'trainer'] && myGym() == g && gymOpen(g); }
    function isActiveIn(g)  { return active() && myGym() == g && gymOpen(g); }
    // Trainer is the currently assigned trainer of member `mid` in gym `g`.
    function trainerHas(g, mid) {
      return isTrainerOf(g)
        && get(/databases/$(database)/documents/members/$(g + '_' + string(mid))).data.assignedTrainerUid == uid();
    }
    // Anyone allowed to coach / view member `mid` of gym `g`.
    function canSeeMember(g, mid) {
      return manages(g) || trainerHas(g, mid) || (isMemberOf(g) && mid == myMemberId());
    }
    function isNumOrNull(v, lo, hi) { return v == null || ((v is int || v is float) && v >= lo && v <= hi); }
    function manages(g)     { return isSuperAdmin() || isAdminOf(g); }

    // A new tenant document: gymId set, id prefixed with the gymId, no plaintext secrets.
    function newDocIn(g, docId) {
      return request.resource.data.gymId == g
        && docId.matches('^' + g + '_.+$')
        && !('password' in request.resource.data)
        && !('secretKey' in request.resource.data);
    }
    function gymUnchanged() { return request.resource.data.gymId == resource.data.gymId; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function isStr(v, max) { return v is string && v.size() <= max; }
    function isNonNegNum(v) { return (v is int || v is float) && v >= 0; }
    function myMemberId() { return me().memberId; }

    // Generic admin-managed per-gym collection.
    function canCreateGymDoc(docId) {
      return manages(request.resource.data.gymId) && newDocIn(request.resource.data.gymId, docId);
    }
    function canUpdateGymDoc() {
      return manages(resource.data.gymId) && gymUnchanged()
        && !('password' in request.resource.data);
    }

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      allow read: if isSuperAdmin()
        || (signedIn() && uid() == userId)
        || (signedIn() && hasProfile() && isAdminOf(resource.data.gymId));

      // (a) claim an invite (email must be verified & match the invite exactly)
      // (b) self-signup as a pending member of an existing gym
      allow create: if signedIn() && uid() == userId && (
          (
            request.auth.token.email_verified == true
            && request.auth.token.email.lower() == request.resource.data.email
            && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
            && request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.role
            && request.resource.data.gymId == get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.gymId
            && request.resource.data.memberId == get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.memberId
            && request.resource.data.status == 'active'
            && request.resource.data.uid == userId
          ) || (
            request.resource.data.role == 'member'
            && request.resource.data.status == 'pending'
            && request.resource.data.memberId == null
            && request.resource.data.uid == userId
            && exists(/databases/$(database)/documents/gymDirectory/$(request.resource.data.gymId))
          )
        ) && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'gymId', 'status', 'memberId', 'staffId', 'createdBy', 'createdAt']);

      allow update: if
          // self: profile cosmetics only — never role / gymId / status / memberId
          (signedIn() && uid() == userId && onlyChanges(['displayName', 'photoURL', 'phone', 'personalStorage', 'shareProgress'])
              && request.resource.data.get('personalStorage', 'firestore') in ['drive', 'firestore']
              && request.resource.data.get('shareProgress', false) is bool)
          // gym admin: manage trainers & members of own gym (approve, disable, link member record)
          || (isAdminOf(resource.data.gymId)
              && resource.data.role in ['trainer', 'member']
              && request.resource.data.role in ['trainer', 'member']
              && gymUnchanged()
              && request.resource.data.status in ['active', 'pending', 'disabled']
              && onlyChanges(['role', 'status', 'memberId', 'staffId', 'displayName']))
          || isSuperAdmin();

      allow delete: if isSuperAdmin()
        || (isAdminOf(resource.data.gymId) && resource.data.role in ['trainer', 'member']);
    }

    // ---------------------------------------------------------------- invites
    // Document id = lower-cased email.
    match /invites/{email} {
      allow read: if isSuperAdmin()
        || (signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email)
        || (hasProfile() && isAdminOf(resource.data.gymId));
      allow create, update: if request.resource.data.email == email
        && request.resource.data.role in ['admin', 'trainer', 'member']
        && (
          isSuperAdmin()
          || (isAdminOf(request.resource.data.gymId)
              && request.resource.data.role in ['trainer', 'member']
              && request.resource.data.createdBy == uid())
        );
      allow delete: if isSuperAdmin()
        || (hasProfile() && isAdminOf(resource.data.gymId))
        || (signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email);
    }

    // ------------------------------------------------------------------- gyms
    match /gyms/{gymId} {
      allow read: if isSuperAdmin() || isActiveIn(gymId)
        || (hasProfile() && myGym() == gymId);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isAdminOf(gymId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['gymId', 'ownerEmail', 'status', 'plan', 'createdBy', 'createdAtMs', 'secretKey']));
    }

    // Public-ish directory used by the self-signup "choose your gym" screen.
    match /gymDirectory/{gymId} {
      allow read: if signedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isAdminOf(gymId) && request.resource.data.gymId == gymId
            && request.resource.data.keys().hasOnly(['gymId', 'gymName', 'city']));
    }

    // ---------------------------------------------------------------- members
    match /members/{docId} {
      allow read: if isSuperAdmin()
        || isAdminOf(resource.data.gymId)
        || (isTrainerOf(resource.data.gymId) && resource.data.assignedTrainerUid == uid())
        || (isMemberOf(resource.data.gymId) && resource.data.id == myMemberId());
      allow create: if canCreateGymDoc(docId)
        && isStr(request.resource.data.name, 120)
        && request.resource.data.id is int;
      allow update: if (canUpdateGymDoc() && request.resource.data.id == resource.data.id)
        // trainer: coaching fields only, and only for their own assigned members
        || (isTrainerOf(resource.data.gymId)
            && resource.data.assignedTrainerUid == uid()
            && onlyChanges(['assignedWorkoutId', 'assignedDietId', 'approvedAiPlan', 'trainerNotes', 'updatedAtMs']));
      allow delete: if manages(resource.data.gymId);
    }

    // ---------------------------------------------- member-visible own records
    match /invoices/{docId} {
      allow read: if manages(resource.data.gymId)
        || (isMemberOf(resource.data.gymId) && resource.data.memberId == myMemberId());
      allow create: if canCreateGymDoc(docId) && isNonNegNum(request.resource.data.amount);
      allow update: if canUpdateGymDoc() && isNonNegNum(request.resource.data.amount);
      allow delete: if manages(resource.data.gymId);
    }
    match /payments/{docId} {
      allow read: if manages(resource.data.gymId)
        || (isMemberOf(resource.data.gymId) && resource.data.memberId == myMemberId());
      allow create: if canCreateGymDoc(docId) && isNonNegNum(request.resource.data.amount);
      allow update: if canUpdateGymDoc() && isNonNegNum(request.resource.data.amount);
      allow delete: if isSuperAdmin();   // payments are an accounting record
    }
    match /attendance/{docId} {
      allow read: if manages(resource.data.gymId)
        || (isMemberOf(resource.data.gymId) && resource.data.memberId == myMemberId());
      allow create: if canCreateGymDoc(docId) && request.resource.data.memberId is int;
      allow update: if canUpdateGymDoc();
      allow delete: if manages(resource.data.gymId);
    }

    // ------------------------------------------ gym-wide reference data (read by all roles)
    match /packages/{docId} {
      allow read: if isSuperAdmin() || isActiveIn(resource.data.gymId);
      allow create: if canCreateGymDoc(docId) && isNonNegNum(request.resource.data.price);
      allow update: if canUpdateGymDoc() && isNonNegNum(request.resource.data.price);
      allow delete: if manages(resource.data.gymId);
    }
    match /workoutTemplates/{docId} {
      allow read: if isSuperAdmin() || isActiveIn(resource.data.gymId);
      allow create: if canCreateGymDoc(docId)
        || (isTrainerOf(request.resource.data.gymId) && newDocIn(request.resource.data.gymId, docId)
            && request.resource.data.createdBy == uid());
      allow update: if canUpdateGymDoc()
        || (isTrainerOf(resource.data.gymId) && resource.data.createdBy == uid() && gymUnchanged()
            && request.resource.data.createdBy == uid());
      allow delete: if manages(resource.data.gymId)
        || (isTrainerOf(resource.data.gymId) && resource.data.createdBy == uid());
    }
    match /dietPlans/{docId} {
      allow read: if isSuperAdmin() || isActiveIn(resource.data.gymId);
      allow create: if canCreateGymDoc(docId)
        || (isTrainerOf(request.resource.data.gymId) && newDocIn(request.resource.data.gymId, docId)
            && request.resource.data.createdBy == uid());
      allow update: if canUpdateGymDoc()
        || (isTrainerOf(resource.data.gymId) && resource.data.createdBy == uid() && gymUnchanged()
            && request.resource.data.createdBy == uid());
      allow delete: if manages(resource.data.gymId)
        || (isTrainerOf(resource.data.gymId) && resource.data.createdBy == uid());
    }

    // ---------------------------------------------------------- trainer sessions
    match /trainerSessions/{docId} {
      allow read: if manages(resource.data.gymId)
        || (isTrainerOf(resource.data.gymId) && resource.data.trainerUid == uid())
        || (isMemberOf(resource.data.gymId) && resource.data.memberId == myMemberId());
      allow create: if isTrainerOf(request.resource.data.gymId)
        && newDocIn(request.resource.data.gymId, docId)
        && request.resource.data.trainerUid == uid()
        && request.resource.data.memberId is int
        && get(/databases/$(database)/documents/members/$(request.resource.data.gymId + '_' + string(request.resource.data.memberId))).data.assignedTrainerUid == uid()
        && isStr(request.resource.data.notes, 1000)
        && request.resource.data.rpe is int && request.resource.data.rpe >= 1 && request.resource.data.rpe <= 10;
      allow update: if (isTrainerOf(resource.data.gymId) && resource.data.trainerUid == uid()
                        && gymUnchanged() && onlyChanges(['notes', 'focus', 'durationMinutes', 'rpe', 'date']))
        || manages(resource.data.gymId);
      allow delete: if manages(resource.data.gymId)
        || (isTrainerOf(resource.data.gymId) && resource.data.trainerUid == uid());
    }

    // --------------------------------------------------------- self-signup requests
    match /joinRequests/{requestUid} {
      allow read: if (signedIn() && uid() == requestUid) || manages(resource.data.gymId);
      allow create: if signedIn() && uid() == requestUid
        && request.resource.data.uid == requestUid
        && exists(/databases/$(database)/documents/gymDirectory/$(request.resource.data.gymId))
        && request.resource.data.keys().hasOnly(['uid', 'gymId', 'email', 'phone', 'displayName', 'createdAt']);
      allow update: if false;
      allow delete: if manages(resource.data.gymId) || (signedIn() && uid() == requestUid);
    }

    // ------------------------------------------------------ admin-only collections
    match /staff/{docId} {
      allow read: if manages(resource.data.gymId);
      allow create: if canCreateGymDoc(docId);
      allow update: if canUpdateGymDoc();
      allow delete: if manages(resource.data.gymId);
    }
    match /expenses/{docId} {
      allow read: if manages(resource.data.gymId);
      allow create: if canCreateGymDoc(docId) && isNonNegNum(request.resource.data.amount);
      allow update: if canUpdateGymDoc() && isNonNegNum(request.resource.data.amount);
      allow delete: if manages(resource.data.gymId);
    }
    match /leads/{docId} {
      allow read: if manages(resource.data.gymId);
      allow create: if canCreateGymDoc(docId);
      allow update: if canUpdateGymDoc();
      allow delete: if manages(resource.data.gymId);
    }
    match /offers/{docId} {
      allow read: if manages(resource.data.gymId);
      allow create: if canCreateGymDoc(docId);
      allow update: if canUpdateGymDoc();
      allow delete: if manages(resource.data.gymId);
    }
    match /reviews/{docId} {
      allow read: if manages(resource.data.gymId);
      allow create: if canCreateGymDoc(docId) && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update: if canUpdateGymDoc();
      allow delete: if manages(resource.data.gymId);
    }
    match /whatsappLogs/{docId} {
      allow read: if manages(resource.data.gymId);
      allow create: if canCreateGymDoc(docId);
      allow update, delete: if isSuperAdmin();
    }
    match /injuries/{docId} {
      allow read: if isSuperAdmin() || isStaffOf(resource.data.gymId);
      allow create: if (isSuperAdmin() || isStaffOf(request.resource.data.gymId))
        && newDocIn(request.resource.data.gymId, docId);
      allow update: if (isSuperAdmin() || isStaffOf(resource.data.gymId)) && gymUnchanged();
      allow delete: if manages(resource.data.gymId);
    }

    // Append-only audit trail.
    match /auditLogs/{docId} {
      allow read: if manages(resource.data.gymId);
      allow create: if (isSuperAdmin() || isStaffOf(request.resource.data.gymId))
        && newDocIn(request.resource.data.gymId, docId)
        && request.resource.data.actorUid == uid();
      allow update, delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------ progress logs (Phase 2)
    // Weight / measurements. Written by the member, their trainer, or the gym admin.
    match /progressLogs/{docId} {
      allow read: if isSuperAdmin() || canSeeMember(resource.data.gymId, resource.data.memberId);
      allow create: if newDocIn(request.resource.data.gymId, docId)
        && request.resource.data.memberId is int
        && canSeeMember(request.resource.data.gymId, request.resource.data.memberId)
        && request.resource.data.createdBy == uid()
        && isStr(request.resource.data.date, 10)
        && isNumOrNull(request.resource.data.get('weightKg', null), 20, 350)
        && isNumOrNull(request.resource.data.get('bodyFatPct', null), 2, 70)
        && isNumOrNull(request.resource.data.get('chestCm', null), 30, 250)
        && isNumOrNull(request.resource.data.get('waistCm', null), 30, 250)
        && isNumOrNull(request.resource.data.get('hipsCm', null), 30, 250)
        && isNumOrNull(request.resource.data.get('armsCm', null), 10, 100)
        && isNumOrNull(request.resource.data.get('thighsCm', null), 20, 150)
        && isStr(request.resource.data.get('notes', ''), 500)
        && request.resource.data.keys().hasOnly(['id', 'gymId', 'memberId', 'date', 'weightKg', 'bodyFatPct', 'chestCm', 'waistCm', 'hipsCm', 'armsCm', 'thighsCm', 'notes', 'createdBy', 'createdByRole', 'createdAtMs', 'updatedAtMs']);
      allow update: if false;   // delete + re-add keeps the history honest
      allow delete: if manages(resource.data.gymId)
        || (signedIn() && resource.data.createdBy == uid() && canSeeMember(resource.data.gymId, resource.data.memberId));
    }

    // ------------------------------------------------------- member plans (Phase 2)
    // Workout + diet plan for one member (AI draft reviewed by the trainer, or written by hand).
    match /plans/{docId} {
      allow read: if isSuperAdmin() || canSeeMember(resource.data.gymId, resource.data.memberId);
      allow create: if newDocIn(request.resource.data.gymId, docId)
        && request.resource.data.memberId is int
        && (manages(request.resource.data.gymId) || trainerHas(request.resource.data.gymId, request.resource.data.memberId))
        && request.resource.data.trainerUid == uid()
        && request.resource.data.status in ['active', 'archived']
        && isStr(request.resource.data.title, 120)
        && request.resource.data.source in ['ai', 'manual'];
      allow update: if gymUnchanged()
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.status in ['active', 'archived']
        && (manages(resource.data.gymId) || trainerHas(resource.data.gymId, resource.data.memberId));
      allow delete: if manages(resource.data.gymId)
        || (trainerHas(resource.data.gymId, resource.data.memberId) && resource.data.trainerUid == uid());
    }

    // ---------------------------------------------------- AI trainer chats (Phase 2)
    // One document per (member, user): id = `${gymId}_${memberId}_${ownerUid}`.
    // Only the owner writes it; the gym admin may read it (member safety / support).
    match /aiChats/{docId} {
      allow read: if isSuperAdmin()
        || manages(resource.data.gymId)
        || (signedIn() && resource.data.ownerUid == uid() && canSeeMember(resource.data.gymId, resource.data.memberId));
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == uid()
        && docId == request.resource.data.gymId + '_' + string(request.resource.data.memberId) + '_' + uid()
        && request.resource.data.memberId is int
        && canSeeMember(request.resource.data.gymId, request.resource.data.memberId)
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 60
        && request.resource.data.keys().hasOnly(['gymId', 'memberId', 'ownerUid', 'ownerRole', 'messages', 'updatedAtMs'])
        && (resource == null || (resource.data.gymId == request.resource.data.gymId && resource.data.memberId == request.resource.data.memberId));
      allow delete: if manages(resource.data.gymId) || (signedIn() && resource.data.ownerUid == uid());
    }

    // ------------------------------------------------- food logs (Phase 2, Firestore fallback)
    // Used only when the member does NOT keep personal data in Google Drive.
    match /foodLogs/{docId} {
      allow read: if isSuperAdmin() || canSeeMember(resource.data.gymId, resource.data.memberId);
      allow create: if newDocIn(request.resource.data.gymId, docId)
        && isMemberOf(request.resource.data.gymId)
        && request.resource.data.memberId == myMemberId()
        && request.resource.data.createdBy == uid()
        && isStr(request.resource.data.date, 10)
        && isStr(request.resource.data.meal, 40)
        && isStr(request.resource.data.text, 500)
        && isNumOrNull(request.resource.data.get('calories', null), 0, 5000)
        && isNumOrNull(request.resource.data.get('proteinG', null), 0, 500)
        && request.resource.data.keys().hasOnly(['id', 'gymId', 'memberId', 'date', 'meal', 'text', 'calories', 'proteinG', 'createdBy', 'createdAtMs']);
      allow update: if false;
      allow delete: if manages(resource.data.gymId) || (signedIn() && resource.data.createdBy == uid());
    }

    // ------------------------------------- progress summary shared with the trainer (Phase 2)
    // id = `${gymId}_${memberId}`. Written only by the member (opt-in); full data stays in their Drive.
    match /progressSummaries/{docId} {
      allow read: if isSuperAdmin() || canSeeMember(resource.data.gymId, resource.data.memberId);
      allow create, update: if isMemberOf(request.resource.data.gymId)
        && request.resource.data.memberId == myMemberId()
        && docId == request.resource.data.gymId + '_' + string(request.resource.data.memberId)
        && request.resource.data.ownerUid == uid()
        && isNumOrNull(request.resource.data.latestWeightKg, 20, 350)
        && isNumOrNull(request.resource.data.startWeightKg, 20, 350)
        && isNumOrNull(request.resource.data.targetWeightKg, 20, 350)
        && isNumOrNull(request.resource.data.goalProgressPct, 0, 100)
        && request.resource.data.keys().hasOnly(['gymId', 'memberId', 'ownerUid', 'latestWeightKg', 'latestDate', 'startWeightKg', 'targetWeightKg', 'goalProgressPct', 'entries', 'updatedAtMs']);
      allow delete: if manages(resource.data.gymId) || (signedIn() && resource.data.ownerUid == uid());
    }

    // Everything else (legacy experimental collections, test docs, ...): denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
