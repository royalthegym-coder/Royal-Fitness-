# =============================================================================
# Fitness Future v2 — browser (Vite) settings.
# Copy to .env.local and fill in. Everything here is PUBLIC (it ends up in the
# browser bundle). NEVER put an API token, secret key or password in this file.
# Real secrets (Gemini, WhatsApp, Razorpay) live ONLY in the Cloudflare Worker:
#   cd cloudflare-backend && npx wrangler secret put GEMINI_API_KEY   (see DEPLOY.md)
# =============================================================================

# --- Firebase web app config (Firebase console > Project settings > Your apps) ---
# Public by design. If left empty, the values in firebase-applet-config.json are used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firestore database id. Free (Spark) quota applies to ONE database — normally "(default)".
VITE_FIRESTORE_DATABASE_ID=(default)

# --- Cloudflare Worker (secrets gateway) URL, no trailing slash ---
# Shown after `npx wrangler deploy`, e.g. https://fitness-future-api.<your-subdomain>.workers.dev
VITE_WORKER_URL=

# Phone OTP login needs Firebase Blaze (paid SMS). Keep false for zero cost.
VITE_ENABLE_PHONE_AUTH=false

# Demo seed data: only works in `npm run dev` AND when this is true. Never in production.
VITE_ENABLE_DEMO_SEED=false

# Super admin (royalthegym@gmail.com) must use a TOTP authenticator app. Keep true.
VITE_SUPER_ADMIN_REQUIRES_MFA=true
