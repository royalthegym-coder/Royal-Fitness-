# ============================================================================
# ENVIRONMENT TEMPLATE - Fitness Future SaaS Platform
# ============================================================================
# यह फाइल template है। इसे .env में rename करके सभी values भरें
# NEVER commit actual .env file to Git - सिर्फ .env.example commit करें
# ============================================================================

# ============================================================================
# 1. SUPABASE CONFIGURATION
# ============================================================================
# Supabase डैशबोर्ड से प्राप्त करें: https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# 2. RAZORPAY CONFIGURATION
# ============================================================================
# Razorpay Dashboard से: https://dashboard.razorpay.com/
# NOTE: Key ID public है (safe to expose), Secret Key को NEVER expose करें
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx  # Live Key शुरू करने के लिए
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here  # Backend के लिए (SECRET)

# ============================================================================
# 3. GOOGLE CONFIGURATION
# ============================================================================
# Google Cloud Console से: https://console.cloud.google.com/
VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=AIzaSyD...  # Maps के लिए
GOOGLE_GEMINI_API_KEY=AIzaSyD...  # Gemini AI के लिए

# ============================================================================
# 4. TWILIO WHATSAPP CONFIGURATION
# ============================================================================
# Twilio Console से: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_PHONE_NUMBER=+14155552671  # Twilio Sandbox number
TWILIO_WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# 5. N8N AUTOMATION CONFIGURATION
# ============================================================================
# यदि self-hosted n8n use कर रहे हैं
N8N_BASE_URL=https://your-n8n-instance.com
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook

# ============================================================================
# 6. APPLICATION CONFIGURATION
# ============================================================================
# Environment
NODE_ENV=production  # development या production
VITE_APP_ENV=production

# App URLs
VITE_APP_URL=https://app.fitnessfuture.com  # Production URL
VITE_API_BASE_URL=https://api.fitnessfuture.com/api  # Backend API URL
VITE_ADMIN_DASHBOARD_URL=https://admin.fitnessfuture.com

# App Branding
VITE_APP_NAME=Fitness Future
VITE_APP_LOGO_URL=https://cdn.fitnessfuture.com/logo.png

# ============================================================================
# 7. STRIPE CONFIGURATION (Optional - if using Stripe instead of Razorpay)
# ============================================================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# 8. SENDGRID CONFIGURATION (Email)
# ============================================================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@fitnessfuture.com
SENDGRID_FROM_NAME=Fitness Future Team

# ============================================================================
# 9. AWS S3 CONFIGURATION (Image/Video Storage)
# ============================================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET_NAME=fitness-future-media
AWS_S3_BUCKET_URL=https://fitness-future-media.s3.ap-south-1.amazonaws.com

# ============================================================================
# 10. JWT & SECURITY
# ============================================================================
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_here
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars_long
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ============================================================================
# 11. PAYMENT & BILLING
# ============================================================================
# Razorpay Subscription Plans
VITE_RAZORPAY_BASIC_PLAN_ID=plan_xxxxx  # Monthly ₹499
VITE_RAZORPAY_PREMIUM_PLAN_ID=plan_xxxxx  # Monthly ₹999
VITE_RAZORPAY_ELITE_PLAN_ID=plan_xxxxx  # Monthly ₹1999

# Webhook Verification
RAZORPAY_WEBHOOK_SECRET=webhook_secret_from_dashboard
RAZORPAY_WEBHOOK_URL=https://api.fitnessfuture.com/api/payments/razorpay-webhook

# ============================================================================
# 12. DATABASE CONFIGURATION (if not using Supabase)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/fitness_future
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=fitness_future

# ============================================================================
# 13. REDIS CONFIGURATION (Caching & Sessions)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# ============================================================================
# 14. LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info  # debug, info, warn, error
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ENVIRONMENT=production

# ============================================================================
# 15. FEATURE FLAGS
# ============================================================================
# AI Features
ENABLE_GEMINI_AI=true
ENABLE_WORKOUT_PLAN_GENERATION=true
ENABLE_DIET_PLAN_GENERATION=true
ENABLE_MEMBER_CHURN_PREDICTION=true

# Automation Features
ENABLE_WHATSAPP_AUTOMATION=true
ENABLE_EMAIL_AUTOMATION=true
ENABLE_SMS_AUTOMATION=false

# Payment Features
ENABLE_SUBSCRIPTION_BILLING=true
ENABLE_MANUAL_INVOICING=true
ENABLE_AUTO_RENEWAL=true

# ============================================================================
# 16. TESTING & DEVELOPMENT
# ============================================================================
# Test Razorpay Credentials (Use these for testing)
TEST_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
TEST_RAZORPAY_SECRET=test_secret_key

# Test Phone Numbers (WhatsApp)
TEST_PHONE_NUMBER=+919785300123
TEST_PHONE_NUMBER_2=+919876543210

# ============================================================================
# 17. GOOGLE BUSINESS CONFIGURATION
# ============================================================================
GOOGLE_BUSINESS_PROFILE_ID=your_business_profile_id
GOOGLE_BUSINESS_ACCOUNT_ID=your_account_id
GOOGLE_BUSINESS_LOCATION_ID=your_location_id

# ============================================================================
# 18. ANALYTICS
# ============================================================================
# Google Analytics
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Mixpanel (Optional)
VITE_MIXPANEL_TOKEN=your_mixpanel_token

# ============================================================================
# 19. CORPORA & DATA VALIDATION
# ============================================================================
# File Upload Limits
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_VIDEO_TYPES=mp4,mov,avi

# Phone Number Format
VITE_PHONE_COUNTRY_CODE=IN
VITE_PHONE_PREFIX=+91

# ============================================================================
# 20. ADMIN CREDENTIALS (Development केवल)
# ============================================================================
# NOTE: Production में ये credentials GitHub में कभी न रखें
ADMIN_EMAIL=admin@fitnessfuture.com
ADMIN_PASSWORD=change_me_in_production
ADMIN_API_KEY=your_admin_api_key

# ============================================================================
# END OF ENVIRONMENT TEMPLATE
# ============================================================================
